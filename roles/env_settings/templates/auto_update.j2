#   This script is designed for very specific use cases in environments with an
#   Air Gap, where routine maintenance is not possible.
#   It relies on an internal Git repository that uses Little-IaC as its engine.
#   It is intended for use via crontab.
#
#   {{ ansible_managed_header }}
#   {{ ansible_managed_warning }}

# Logging setup
LOG_FILE="/var/log/auto-update.log"
touch "$LOG_FILE" 2>/dev/null || { echo "Cannot write to $LOG_FILE" >&2; exit 1; }

# Logging function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# Function to check command status
check_status() {
    if [ $? -eq 0 ]; then
        log "  ✓ SUCCESS: $1"
        return 0
    else
        log "  ✗ FAILED: $1 (exit code: $?)"
        return 1
    fi
}

# Function to create hard links
create_links() {
    local source="$1"
    local dest="$2"
    local name="$3"
    
    if [ ! -d "$source" ]; then
        log "  Warning: Source '$source' does not exist, skipping $name"
        return 1
    fi
    
    log "  Creating hard links for $name"
    rm -rf "$dest"
    cp -al "$source" "$dest"
    
    local count=$(find "$dest" -type f 2>/dev/null | wc -l)
    log "  Created $count hard links for $name"
}

# Start logging
log "=== Starting automatic maintenance ==="

# ===== 1. FRESH CLONE / RESET =====
REPO_PATH="{{ repo_path }}"
cd "$REPO_PATH"
check_status "Changed to directory $REPO_PATH" || exit 1

log "Fetching latest changes from git"
git fetch origin
check_status "Git fetch" || exit 1

log "Hard resetting to origin/main"
git reset --hard origin/main
check_status "Git hard reset" || exit 1

log "Cleaning untracked files"
git clean -fdx
check_status "Git clean" || exit 1
# ===== END OF FRESH RESET =====

# ===== 2. SUBMODULE + LINKS =====
log "Reinitializing Little-IaC submodule"
rm -rf Little-IaC
git submodule update --init --recursive
check_status "Submodule init and update" || exit 1

log "Creating hard links for host/group variables"
create_links "host_vars" "Little-IaC/host_vars" "host_vars"
create_links "group_vars" "Little-IaC/group_vars" "group_vars"
# ===== END OF SUBMODULE + LINKS =====

# ===== 3. RUN ANSIBLE =====
cd Little-IaC
check_status "Changed to directory Little-IaC" || exit 1

log "Running Ansible playbook for host: {{ ansible_facts['hostname'] }}"
log "--- Ansible output start ---"
ansible-playbook -l {{ ansible_facts["hostname"] }} desktop.yaml
ANSIBLE_EXIT=$?
log "--- Ansible output end (exit code: $ANSIBLE_EXIT) ---"

if [ $ANSIBLE_EXIT -eq 0 ]; then
    log "✓ Ansible playbook completed successfully"
else
    log "✗ Ansible playbook FAILED with exit code $ANSIBLE_EXIT"
    exit $ANSIBLE_EXIT
fi
# ===== END OF ANSIBLE =====

# ===== 4. CLEANUP =====
log "Cleaning up repository content (keeping .git)"
cd "$REPO_PATH"
find . -maxdepth 1 -not -name '.git' -not -name '.' -not -name '..' -exec rm -rf {} +
check_status "Cleanup of repo/*"

log "=== Automatic maintenance completed successfully ==="