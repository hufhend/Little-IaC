# {{ ansible_managed_header }}
# {{ ansible_managed_warning }}

# Complete system update
{% if ansible_facts['os_family'] == "RedHat" %}
{{ mntm }} 00   *  *   *     sudo /usr/bin/dnf update -y
{% elif ansible_facts['os_family'] == "Debian" %}
{{ mntm }} 00   *  *   *     sudo apt -f install -y && sudo apt update && sudo apt upgrade -y && sudo apt dist-upgrade -y && sudo apt autoremove -y && sudo apt autoclean -y
{% endif %}

00 03  {{ mntd }}  *   *     sudo /usr/sbin/reboot

{% if addition_cron is defined %}
# Special tasks only for this machine
{% for task in addition_cron %}
# {{ task.name }}
{{ task.minute | default('*') }} {{ task.hour | default('*') }} {{ task.day | default('  *') }} {{ task.month | default(' *') }} {{ task.weekday | default('  *') }}     {{ task.job }}
{% endfor %}
{% endif %}
