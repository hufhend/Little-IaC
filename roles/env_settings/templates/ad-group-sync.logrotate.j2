# {{ ansible_managed_header }}
# {{ ansible_managed_warning }}
#
# Logrotate configuration for AD group synchronization script

/var/log/ad-group-sync.log {
    monthly
    rotate {{ logrotate_retention | default(5) }}
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root root
    su root root
    nodateext
    {% if ansible_facts['os_family'] == 'RedHat' %}
    postrotate
        /usr/bin/killall -HUP rsyslogd 2> /dev/null || true
    endscript
    {% elif ansible_facts['os_family'] == 'Debian' %}
    postrotate
        /usr/sbin/invoke-rc.d rsyslog rotate >/dev/null 2>&1 || true
    endscript
    {% else %}
    # Generic postrotate for other distributions
    postrotate
        true
    endscript
    {% endif %}
}
